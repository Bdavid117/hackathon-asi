<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SARD es una app oscura que se abre a menudo de noche: la ventana de arranque es del color de la app
         tanto con el modo claro como con el oscuro del sistema (antes salía blanca). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Color de la ventana mientras arranca Flutter y detrás de su interfaz (sólo con el motor V2). -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
